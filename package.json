{
  "name": "femtopix",
  "version": "0.1.0",
  "description": "Gömülü sistem ekranları için yerel tasarım ve kod üretme aracı",
  "author": "femtopix",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Muhammed-Turgut/ivec_draw",
  "main": "./out/main/index.js",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "build": "electron-vite build",
    "dist": "electron-vite build && electron-builder",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "dist:win": "electron-vite build && env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync:pixel-icons": "node scripts/sync-pixel-icons.mjs",
    "sync:pixelarticons": "node scripts/sync-pixelarticons.mjs",
    "make:anims": "node scripts/make-pixel-anims.mjs"
  },
  "dependencies": {
    "i18next": "^25.5.2",
    "immer": "^10.1.3",
    "lucide-react": "^0.544.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^15.7.3",
    "react-resizable-panels": "^3.0.5",
    "zod": "^3.25.76",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
